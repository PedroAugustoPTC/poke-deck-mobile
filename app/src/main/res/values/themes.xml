<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Ponta a ponta em todas as versões (o Android 15+ força isso): a raiz aplica os insets, igual do 8 ao 16. -->
    <style name="Theme.PokeDeck" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:colorAccent">@color/gold</item>
        <item name="android:colorPrimary">@color/wood</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:fontFamily">@font/barlow</item>
        <item name="android:alertDialogTheme">@style/Dialog.PokeDeck</item>
    </style>
    <style name="Dialog.PokeDeck" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">@color/gold</item>
        <item name="android:colorBackground">@color/panelHigh</item>
        <item name="android:fontFamily">@font/barlow</item>
    </style>
</resources>
